# ============================================================================
# TK Laptop — Environment Variables Example
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
# ============================================================================

# 1. Auth.js (NextAuth v5) Secret (Required in production)
# Generate a strong random 32-byte secret using either command:
#   npx auth secret
#   openssl rand -base64 32
AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"

# Base URL of the site (used for password reset links and OAuth callbacks)
NEXTAUTH_URL="http://localhost:3000"

# 2. Optional Google OAuth Provider
# Leave empty or omit to disable Google Sign-In cleanly without breaking the app.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
